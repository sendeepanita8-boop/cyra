# =====================================================================
# CYRA Security Scanner — Environment Variables Template
# =====================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit .env.local to version control.
# =====================================================================

# ── Application ──────────────────────────────────────────────────────
# The canonical URL of your deployment. Used for sitemap, OG tags, etc.
NEXT_PUBLIC_APP_URL=https://cyra.app

# Node environment (development | production | test)
NODE_ENV=production

# ── Rate Limiting ────────────────────────────────────────────────────
# Override the in-memory rate limit defaults (optional).
# For production, replace the in-memory store with a Redis-backed limiter.
#
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_SECONDS=60

# ── Scanner Behaviour ────────────────────────────────────────────────
# Maximum outbound fetch timeout in milliseconds.
# SCAN_TIMEOUT_MS=8000

# ── Telemetry ────────────────────────────────────────────────────────
# Disable Next.js anonymous telemetry collection.
NEXT_TELEMETRY_DISABLED=1

# ── Port (self-hosted / Docker) ───────────────────────────────────────
PORT=3000
